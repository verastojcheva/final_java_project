<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp"
    android:background="#FFFFFF"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:id="@+id/lutemonCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@android:color/white"
        android:elevation="2dp"
        android:padding="8dp"
        android:minHeight="80dp"> <!-- Ensures space for 48dp buttons -->

        <!-- Lutemon Image -->
        <ImageView
            android:id="@+id/imageLutemon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_launcher_foreground" />

        <!-- Lutemon Info -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <TextView
                android:id="@+id/textLutemonName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Name"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/textLutemonStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stats" />
        </LinearLayout>

        <!-- Selection + Delete Column -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginStart="8dp">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_horizontal">

                <CheckBox
                    android:id="@+id/checkboxSelect"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:buttonTint="@android:color/black" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp">

                <ImageButton
                    android:id="@+id/btnDelete"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/trash_icon"
                    android:scaleType="centerInside"
                    android:background="@android:color/transparent"
                    android:contentDescription="Delete Lutemon" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
